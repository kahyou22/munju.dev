---
// 손그림 알약 모양 태그. 누르면 그 태그의 글 목록(/tags/태그)으로 간다.
import { tagHref } from "../lib/posts";
import { ROUGH_PRESETS } from "../lib/rough";
import { roughAttrs } from "../lib/rough-decor";

interface Props {
  name: string;
  /** 손그림 모양을 고르는 값. 같은 이름의 태그라도 글마다 다르게 생기도록 넘긴다. */
  seed?: string;
  /** 태그 옆에 붙이는 글 수 (태그 모음 페이지) */
  count?: number;
  /** false면 링크 없이 보이기만 한다. 일부 공개 글에만 붙은 태그는 태그 페이지가 없다. */
  link?: boolean;
}

const { name, seed = name, count, link = true } = Astro.props;
const Element = link ? "a" : "span";

// 같은 태그는 항상 같은 색이 되도록 이름으로 색을 고른다.
const COLORS = ["pink", "blue"] as const;
const hash = [...name].reduce((sum, char) => sum + char.charCodeAt(0), 0);
const color = COLORS[hash % COLORS.length];
---

<Element
  class:list={["tag", color]}
  href={link ? tagHref(name) : undefined}
  {...roughAttrs({ kind: "box", fill: true, seed, radius: 11, ...ROUGH_PRESETS.chip })}>{name}{count !== undefined && <span class="count">{count}</span>}</Element
>

<style>
  .tag {
    position: relative;
    display: inline-flex;
    align-items: center;
    height: 25px;
    padding: 0 11px;
    font-family: var(--font-hand);
    letter-spacing: var(--hand-tracking);
    /* 개구는 획이 가늘어서 작게 쓰면 흐릿하다. 굵게 16px로 쓴다. */
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    color: var(--tag-text);
    --rough-stroke: var(--tag-line);
    --rough-stroke-width: 1.3;
    --rough-fill: transparent;
  }

  /* 마우스를 올리면 태그 색으로 옅게 칠해진다. */
  a.tag:hover {
    text-decoration: none;
    --rough-fill: color-mix(in srgb, var(--tag-line) 16%, transparent);
  }

  .count {
    margin-left: 5px;
    font-weight: 400;
    opacity: 0.75;
  }

  /* 선은 포인트 색 그대로, 글자는 바탕 위에서 읽히도록 더 진하게(어두운 테마에서는 더 밝게) 쓴다. */
  .pink {
    --tag-line: #f09a95;
    --tag-text: #b5524e;
  }

  .blue {
    --tag-line: #7491c8;
    --tag-text: #4f6ca8;
  }

  :global(:root[data-theme="dark"]) .pink {
    --tag-text: #fda9a6;
  }

  :global(:root[data-theme="dark"]) .blue {
    --tag-text: #abc4e3;
  }
</style>
