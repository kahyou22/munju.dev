---
// 손으로 두 번 그은 듯한 가로선. seed가 다르면 떨림과 어긋난 정도가 달라진다.
import { between } from "../lib/hand-drawn";
import { wobbleFilter } from "../lib/wobble";

interface Props {
  seed: string;
  class?: string;
}

const { seed, class: className } = Astro.props;

const style = [
  `--wobble-a: ${wobbleFilter(seed, "a")}`,
  `--wobble-b: ${wobbleFilter(seed, "b")}`,
  `--rule-shift-start: ${between(seed, 2, 14, "start").toFixed(1)}px`,
  `--rule-shift-end: ${between(seed, 0, 10, "end").toFixed(1)}px`,
  `--rule-gap: ${between(seed, 2, 4.5, "gap").toFixed(1)}px`,
].join("; ");
---

<div class:list={["rule", className]} style={style} aria-hidden="true"></div>
