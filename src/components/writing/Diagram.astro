---
// 손그림 다이어그램. 빌드할 때 SVG로 그려서 브라우저로 가는 JS는 없다.
// - 스크롤해서 화면에 들어오면 선이 스스로 그려진다.
// - 상자에 마우스를 올리면 상자가 꿈틀거리고, 연결된 화살표가 강조된다.
//
// MDX:
//   <Diagram flow={["입력", "처리", "출력"]} />
//   <Diagram
//     nodes={[{ id: "a", label: "MDX", col: 0, row: 0 }, { id: "b", label: "플러그인", col: 1, row: 0, tone: "accent" }]}
//     edges={[{ from: "a", to: "b", label: "변환" }]}
//     caption="캡션"
//   />
// tone: default | accent | highlight | tip | muted, shape: box | pill | text, 줄바꿈은 label에 \n
import { layoutDiagram, type DiagramEdge, type DiagramNode } from "../../lib/diagram";
import { pick } from "../../lib/hand-drawn";

interface Props {
  nodes?: DiagramNode[];
  edges?: DiagramEdge[];
  flow?: string[];
  caption?: string;
  /** 화면 낭독기용 설명. 없으면 캡션을 쓴다. */
  label?: string;
  seed?: string;
}

const { flow, caption, label } = Astro.props;
let { nodes = [], edges = [] } = Astro.props;
if (flow) {
  nodes = flow.map((text, i) => ({ id: `n${i}`, label: text, col: i, row: 0 }));
  edges = flow.slice(1).map((_, i) => ({ from: `n${i}`, to: `n${i + 1}` }));
}

const seed = Astro.props.seed ?? nodes.map((n) => n.label).join("|");
const diagram = layoutDiagram(nodes, edges, seed);
const id = `diagram-${pick(seed, 1_000_000_000)}`;

// 상자에 마우스를 올리면 그 상자에 연결된 화살표만 강조한다.
const hoverCss = diagram.nodes
  .map((n) => `#${id}:has(.n-${n.index}:hover) .e-${n.index} { --edge-color: var(--color-link); }`)
  .join("\n");
---

<figure class="diagram" id={id}>
  <svg viewBox={`0 0 ${diagram.width} ${diagram.height}`} role="img" aria-label={label ?? caption ?? "다이어그램"}>
    <g class="edges">
      {
        diagram.edges.map((edge) => (
          <g class:list={["edge", `e-${edge.from}`, `e-${edge.to}`, { dashed: edge.dashed }]}>
            {edge.strokes.map((d) => (
              <path class="draw" d={d} pathLength="1" />
            ))}
            {edge.label && (
              <text class="edge-label" x={edge.labelX} y={edge.labelY} text-anchor={edge.labelAnchor}>
                {edge.label}
              </text>
            )}
          </g>
        ))
      }
    </g>
    <g class="nodes">
      {
        diagram.nodes.map((node) => (
          <g class:list={["node", "boil-on-hover", `n-${node.index}`, `tone-${node.tone}`, `shape-${node.shape}`]}>
            {node.frames.map((frame, f) => (
              <g class="shape" data-frame={f}>
                {frame.fills.map((d) => (
                  <path class="fill" d={d} />
                ))}
                {frame.strokes.map((d) => (
                  <path class="draw" d={d} pathLength="1" />
                ))}
              </g>
            ))}
            <text class="node-label" x={node.cx} y={node.cy - ((node.lines.length - 1) * diagram.lineHeight) / 2}>
              {node.lines.map((line, i) => (
                <tspan x={node.cx} dy={i === 0 ? 0 : diagram.lineHeight}>
                  {line}
                </tspan>
              ))}
            </text>
          </g>
        ))
      }
    </g>
  </svg>
  {caption && <figcaption>{caption}</figcaption>}
  <style is:inline set:html={hoverCss}></style>
</figure>

<style>
  .diagram {
    margin: 2em 0;
    view-timeline-name: --diagram;
  }

  svg {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
    overflow: visible;
  }

  /* 상자 색: Callout과 같은 색을 쓴다. */
  .node {
    --node-line: var(--color-title);
    --node-fill: var(--code-bg);
    --node-text: var(--color-title);
  }

  .tone-accent {
    --node-line: var(--callout-note-line);
    --node-fill: var(--callout-note-bg);
    --node-text: var(--callout-note-label);
  }

  .tone-highlight {
    --node-line: var(--callout-warn-line);
    --node-fill: var(--callout-warn-bg);
    --node-text: var(--callout-warn-label);
  }

  .tone-tip {
    --node-line: var(--callout-tip-line);
    --node-fill: var(--callout-tip-bg);
    --node-text: var(--callout-tip-label);
  }

  .tone-muted {
    --node-line: var(--color-border-strong);
    --node-fill: transparent;
    --node-text: var(--color-muted);
  }

  .fill {
    fill: var(--node-fill);
    stroke: none;
  }

  .node .draw {
    fill: none;
    stroke: var(--node-line);
    stroke-width: 1.35;
    stroke-linecap: round;
  }

  .edge {
    --edge-color: var(--color-muted);
  }

  .edge .draw {
    fill: none;
    stroke: var(--edge-color);
    stroke-width: 1.3;
    stroke-linecap: round;
    transition: stroke 0.2s;
  }

  .edge.dashed .draw {
    stroke-dasharray: 0.02 0.025;
  }

  text {
    font-family: var(--font-hand);
    dominant-baseline: central;
  }

  .node-label {
    text-anchor: middle;
  }

  .node-label {
    font-size: 18px;
    font-weight: 700;
    fill: var(--node-text);
  }

  .edge-label {
    font-size: 15px;
    fill: var(--edge-color);
    paint-order: stroke;
    stroke: var(--color-bg);
    stroke-width: 6px;
    stroke-linejoin: round;
    transition: fill 0.2s;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* 스크롤해서 화면에 들어오면 선이 스스로 그려지고, 면과 글자는 뒤따라 나타난다. */
    @supports (animation-timeline: view()) {
      .node .draw,
      .edge:not(.dashed) .draw {
        stroke-dasharray: 1;
        animation: draw linear both;
        animation-timeline: --diagram;
        animation-range: entry 10% cover 40%;
      }

      .fill,
      text {
        animation: appear linear both;
        animation-timeline: --diagram;
        animation-range: entry 25% cover 45%;
      }
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  figcaption {
    margin-top: 10px;
    font-family: var(--font-hand);
    letter-spacing: var(--hand-tracking);
    font-size: 17px;
    line-height: 1.4;
    text-align: center;
    color: var(--color-muted);
  }
</style>
