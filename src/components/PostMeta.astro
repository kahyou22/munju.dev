---
// 글 위쪽의 날짜·태그 줄.
import Tag from "./Tag.astro";
import { formatDate, tagsWithPage } from "../lib/posts";

interface Props {
  date: Date;
  tags: string[];
  /** 손그림 모양을 고르는 값. 글마다 다르게 생기도록 글 id를 넘긴다. */
  seed: string;
}

const { date, tags, seed } = Astro.props;

// 태그 페이지는 목록에 보이는 글의 태그로만 만든다. 일부 공개 글에만 있는 태그는 링크하지 않는다.
const linkedTags = await tagsWithPage();
---

<div class="meta">
  <time datetime={date.toISOString()}>{formatDate(date)}</time>
  {tags.map((tag) => <Tag name={tag} seed={`${seed}-${tag}`} link={linkedTags.has(tag)} />)}
</div>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: var(--font-hand);
    letter-spacing: var(--hand-tracking);
    font-size: 15px;
    color: var(--color-muted);
  }

  time {
    margin-right: 4px;
  }
</style>
