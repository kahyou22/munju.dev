---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostMeta from "../../components/PostMeta.astro";
import HandUnderline from "../../components/HandUnderline.astro";
import HandArrow from "../../components/HandArrow.astro";
import { fullComponents } from "../../components/mdx";
import { getListedPosts, getPosts, listHref, type Post } from "../../lib/posts";
import { ogImagePath } from "../../lib/site";
import "../../styles/prose.css";

export async function getStaticPaths() {
  const [posts, listed] = await Promise.all([getPosts(), getListedPosts()]);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, backHref: listHref(listed, post.id) } }));
}

interface Props {
  post: Post;
  /** 글 목록에서 이 글이 있던 자리 */
  backHref: string;
}

const { post, backHref } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImagePath(post.id)}
  published={post.data.date}
  tags={post.data.tags}
  noindex={post.data.unlisted}
>
  <article>
    <header class="post-header">
      <PostMeta date={post.data.date} tags={post.data.tags} seed={post.id} />
      <h1><HandUnderline seed={post.id} data-vt-title>{post.data.title}</HandUnderline></h1>
    </header>
    <div class="prose">
      <Content components={fullComponents} />
    </div>
    <footer class="post-footer">
      <a class="back draw-underline" href={backHref}><HandArrow direction="left" seed={`back-${post.id}`} />글 목록으로</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 40px;
  }

  /* 목록에서 고른 글의 제목과 날짜·태그 줄이 여기로 이어진다. (scripts/page-transition.js) */
  .post-header :global([data-vt-meta]) {
    view-transition-name: post-meta;
  }

  h1 :global([data-vt-title]) {
    view-transition-name: post-title;
  }

  .post-footer {
    margin-top: 56px;
  }

  .back {
    font-family: var(--font-hand);
    letter-spacing: var(--hand-tracking);
    font-size: 17px;
  }

  h1 {
    margin: 10px 0 0;
    font-size: 30px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--color-title);
  }
</style>
