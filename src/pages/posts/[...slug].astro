---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostMeta from "../../components/PostMeta.astro";
import HandUnderline from "../../components/HandUnderline.astro";
import { fullComponents } from "../../components/mdx";
import { getPosts, type Post } from "../../lib/posts";
import { ogImagePath } from "../../lib/site";
import "../../styles/prose.css";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={ogImagePath(post.id)}
  published={post.data.date}
  tags={post.data.tags}
  noindex={post.data.unlisted}
>
  <article>
    <header class="post-header">
      <PostMeta date={post.data.date} tags={post.data.tags} seed={post.id} />
      <h1><HandUnderline seed={post.id} data-vt-title>{post.data.title}</HandUnderline></h1>
    </header>
    <div class="prose">
      <Content components={fullComponents} />
    </div>
  </article>
</BaseLayout>

<style>
  .post-header {
    margin-bottom: 40px;
  }

  /* 목록에서 고른 글의 제목과 날짜·태그 줄이 여기로 이어진다. (scripts/page-transition.js) */
  .post-header :global([data-vt-meta]) {
    view-transition-name: post-meta;
  }

  h1 :global([data-vt-title]) {
    view-transition-name: post-title;
  }

  h1 {
    margin: 10px 0 0;
    font-size: 30px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.02em;
    color: var(--color-title);
  }
</style>
